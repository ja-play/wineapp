rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isEvaluator() {
      return request.auth != null && (getUserRole() == 'evaluator' || isAdmin());
    }

    function isDepot() {
      return request.auth != null && (getUserRole() == 'depot' || isAdmin());
    }

    // User Roles & Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Client Shops Collection
    match /shops/{shopId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Wine Catalog Collection
    match /wines/{sku} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isEvaluator() || isDepot() || isAdmin();
      allow create: if isEvaluator() || isAdmin();
      allow update, delete: if isDepot() || isAdmin();
    }
  }
}
