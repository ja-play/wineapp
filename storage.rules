rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /wines/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /wine-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /invoices/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if true; // Cloud Function / admin
    }
  }
}

